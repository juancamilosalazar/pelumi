# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# El catálogo y sus imágenes SÍ se versionan: así el sitio desplegado arranca
# con contenido en vez de vacío. Cuando el catálogo real sea grande, conviene
# moverlo a un disco persistente del hosting y volver a ignorarlo aquí.

# Las métricas son datos de cada entorno: nunca se versionan.
/data/metrics.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
